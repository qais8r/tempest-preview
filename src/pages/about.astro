---
import Site from '../layouts/Site.astro';
import { site, prose, currentIssue, readerUrl, url, imageSrcset } from '../lib/content';
import Icon from '../components/Icon.astro';
---

<Site title="About"
  ><main id="main" class="site-main about-page" aria-label="About the publication">
    <section class="about-layout">
      <figure>
        <img
          src={url(currentIssue.cover)}
          srcset={imageSrcset(currentIssue.coverSources)}
          sizes="(max-width: 720px) calc(100vw - 2rem), min(42vw, 35.6rem)"
          alt={currentIssue.heroCredit || 'The current issue cover'}
          width={currentIssue.coverWidth}
          height={currentIssue.coverHeight}
        /><figcaption>{currentIssue.heroCredit}</figcaption>
      </figure><div>
        <div class="prose" set:html={prose(site.about)} /><p class="eyebrow">{site.school}</p><a
          class="button button-outline"
          href={readerUrl(currentIssue)}>Read the latest issue <Icon name="arrow" /></a>
      </div>
    </section>
  </main></Site
>
