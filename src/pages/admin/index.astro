---
import { site, url } from '../../lib/content';
import ViewTransitions from '../../components/ViewTransitions.astro';
const cmsUrl = `https://app.pagescms.org/${site.editorialRepo}/main`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${cmsUrl}`} />
    <title>Opening Pages CMS</title>
    <ViewTransitions root={url('/')} />
  </head>
  <body><p><a href={cmsUrl}>Continue to Pages CMS</a></p></body>
</html>
