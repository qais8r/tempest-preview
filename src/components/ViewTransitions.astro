---
import script from '../scripts/view-transitions.js?raw';

interface Props {
  root: string;
}
const { root } = Astro.props;
---

<style is:inline>
  @view-transition {
    navigation: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }
</style>
<!-- This must run in the head before the first render, including on a cold navigation. -->
<script is:inline data-transition-root={root} set:html={script} />
