---
interface Props {
  root: string;
}

const { root: transitionRoot } = Astro.props;
---

<style is:inline set:html="@view-transition { navigation: auto; }"></style>
<script is:inline define:vars={{ transitionRoot }}>
  (() => {
    const basePath = new URL(transitionRoot, location.origin).pathname;
    const authorStorageKey = 'tempest-author-transition';
    const workStorageKey = 'tempest-work-transition';
    let clickedLink = null;

    const localPath = (value) => {
      const pathname = new URL(value, location.href).pathname;
      if (!pathname.startsWith(basePath)) return null;
      return `/${pathname.slice(basePath.length)}`;
    };
    const authorSlug = (path) => path?.match(/^\/authors\/([^/]+)\/$/)?.[1] || null;
    const workSlug = (path) => path?.match(/^\/works\/([^/]+)\/$/)?.[1] || null;
    const workCardAnchors = (slug) =>
      [...document.querySelectorAll('a[data-work-transition]')].filter(
        (element) =>
          element.dataset.workTransition === slug &&
          element.dataset.workTransitionContext === 'card',
      );
    const isAuthorIndex = (path) => path === '/authors/';
    const isWork = (path) => /^\/works\/[^/]+\/$/.test(path || '');
    const isIssueSurface = (path) =>
      path === '/' || path === '/issues/' || /^\/issues\/\d{4}\/$/.test(path || '');
    const isWorkCardSurface = (path) => isIssueSurface(path) || Boolean(authorSlug(path));
    const authorRoute = (from, to) => {
      const destinationAuthor = authorSlug(to);
      if (destinationAuthor && (isAuthorIndex(from) || isWork(from))) {
        return { slug: destinationAuthor, destinationContext: 'profile' };
      }
      const sourceAuthor = authorSlug(from);
      if (sourceAuthor && (isAuthorIndex(to) || isWork(to))) {
        return {
          slug: sourceAuthor,
          destinationContext: isAuthorIndex(to) ? 'card' : 'byline',
        };
      }
      return null;
    };
    const workRoute = (from, to) => {
      const destinationWork = workSlug(to);
      if (destinationWork && isWorkCardSurface(from)) {
        return { slug: destinationWork, destinationContext: 'detail' };
      }
      const sourceWork = workSlug(from);
      if (sourceWork && isWorkCardSurface(to)) {
        return { slug: sourceWork, destinationContext: 'card' };
      }
      return null;
    };
    const defaultSource = (path) => {
      if (isAuthorIndex(path)) return { context: 'card', parts: ['portrait', 'name'] };
      if (authorSlug(path)) return { context: 'profile', parts: ['portrait', 'name'] };
      return { context: 'byline', parts: ['name'] };
    };
    const defaultWorkSource = (path) => ({
      context: workSlug(path) ? 'detail' : 'card',
      parts: ['title', 'author'],
    });
    const markAuthor = (slug, context, parts, until) => {
      const marked = [];
      document.querySelectorAll('[data-author-transition-author]').forEach((element) => {
        if (
          element.dataset.authorTransitionAuthor === slug &&
          element.dataset.authorTransitionContext === context &&
          parts.includes(element.dataset.authorTransitionPart)
        ) {
          element.style.viewTransitionName = `author-${element.dataset.authorTransitionPart}`;
          marked.push(element);
        }
      });
      document.documentElement.style.viewTransitionName = 'none';
      Promise.resolve(until)
        .catch(() => {})
        .then(() => {
          document.documentElement.style.viewTransitionName = '';
          marked.forEach((element) => {
            element.style.viewTransitionName = '';
          });
        });
    };
    const markWork = (slug, context, parts, until, scope = document) => {
      const names = { title: 'work-title', author: 'work-author' };
      const marked = [];
      const markedParts = new Set();
      scope.querySelectorAll('[data-work-transition-work]').forEach((element) => {
        const part = element.dataset.workTransitionPart;
        if (
          element.dataset.workTransitionWork === slug &&
          element.dataset.workTransitionContext === context &&
          parts.includes(part) &&
          names[part] &&
          (scope !== document || !markedParts.has(part))
        ) {
          element.style.viewTransitionName = names[part];
          marked.push(element);
          markedParts.add(part);
        }
      });
      document.documentElement.style.viewTransitionName = 'none';
      Promise.resolve(until)
        .catch(() => {})
        .then(() => {
          document.documentElement.style.viewTransitionName = '';
          marked.forEach((element) => {
            element.style.viewTransitionName = '';
          });
        });
    };

    document.addEventListener(
      'click',
      (event) => {
        const anchor = event.target instanceof Element ? event.target.closest('a[href]') : null;
        if (!anchor) return;
        clickedLink = {
          to: localPath(anchor.href),
          slug: anchor.dataset.authorTransition || null,
          context: anchor.dataset.authorTransitionContext || null,
          parts: (anchor.dataset.authorTransitionParts || '').split(' ').filter(Boolean),
          workSlug: anchor.dataset.workTransition || null,
          workContext: anchor.dataset.workTransitionContext || null,
          workParts: (anchor.dataset.workTransitionParts || '').split(' ').filter(Boolean),
          anchor,
        };
      },
      { capture: true },
    );

    window.addEventListener('pageswap', (event) => {
      if (!event.viewTransition) return;
      const from = localPath(location.href);
      const to = event.activation?.entry?.url
        ? localPath(event.activation.entry.url)
        : clickedLink?.to;
      const work = workRoute(from, to);
      const clickedWork =
        work && clickedLink?.to === to && clickedLink?.workSlug === work.slug ? clickedLink : null;
      if (work) {
        const fallback = defaultWorkSource(from);
        const context = clickedWork?.workContext || fallback.context;
        const parts = clickedWork?.workParts.length ? clickedWork.workParts : fallback.parts;
        const cardIndex = clickedWork?.anchor
          ? workCardAnchors(work.slug).indexOf(clickedWork.anchor)
          : -1;
        const record = {
          from,
          to,
          slug: work.slug,
          parts,
          destinationContext: work.destinationContext,
          cardIndex: cardIndex >= 0 ? cardIndex : null,
        };
        try {
          sessionStorage.setItem(workStorageKey, JSON.stringify(record));
        } catch {}
        markWork(work.slug, context, parts, event.viewTransition.finished, clickedWork?.anchor);
        clickedLink = null;
        return;
      }
      const route = authorRoute(from, to);
      if (route) {
        const fallback = defaultSource(from);
        const clickedAuthor =
          clickedLink?.to === to && clickedLink?.slug === route.slug ? clickedLink : null;
        const context = clickedAuthor?.context || fallback.context;
        const parts = clickedAuthor?.parts.length ? clickedAuthor.parts : fallback.parts;
        const record = {
          from,
          to,
          slug: route.slug,
          parts,
          destinationContext: route.destinationContext,
        };
        try {
          sessionStorage.setItem(authorStorageKey, JSON.stringify(record));
        } catch {}
        markAuthor(route.slug, context, parts, event.viewTransition.finished);
        clickedLink = null;
        return;
      }
      if (!(isIssueSurface(from) && isIssueSurface(to))) {
        event.viewTransition.skipTransition();
      }
      clickedLink = null;
    });

    window.addEventListener('pagereveal', (event) => {
      if (!event.viewTransition) return;
      const current = localPath(location.href);
      let record = null;
      try {
        record = JSON.parse(sessionStorage.getItem(authorStorageKey));
        sessionStorage.removeItem(authorStorageKey);
      } catch {}
      const activation = Reflect.get(window, 'navigation')?.activation;
      const from =
        record?.to === current
          ? record.from
          : activation?.from?.url
            ? localPath(activation.from.url)
            : null;
      const route = authorRoute(from, current);
      if (route) {
        const parts = record?.slug === route.slug ? record.parts : defaultSource(from).parts;
        const context =
          record?.slug === route.slug ? record.destinationContext : route.destinationContext;
        markAuthor(route.slug, context, parts, event.viewTransition.ready);
        return;
      }
      let workRecord = null;
      try {
        workRecord = JSON.parse(sessionStorage.getItem(workStorageKey));
        sessionStorage.removeItem(workStorageKey);
      } catch {}
      const work = workRoute(from, current);
      if (work && workRecord?.to === current && workRecord?.slug === work.slug) {
        const parts = workRecord.parts?.length ? workRecord.parts : defaultWorkSource(from).parts;
        const destinationScope =
          workRecord.destinationContext === 'card' && Number.isInteger(workRecord.cardIndex)
            ? workCardAnchors(work.slug)[workRecord.cardIndex] || document
            : document;
        markWork(
          work.slug,
          workRecord.destinationContext || work.destinationContext,
          parts,
          event.viewTransition.ready,
          destinationScope,
        );
        return;
      }
      if (from && !(isIssueSurface(from) && isIssueSurface(current))) {
        event.viewTransition.skipTransition();
      }
    });
  })();
</script>
