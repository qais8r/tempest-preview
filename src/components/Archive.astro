---
import { issues, issueUrl, url, imageSrcset, type Issue } from '../lib/content';
import Icon from './Icon.astro';
interface Props {
  exclude?: string;
  heading?: string;
  headingLevel?: 'h1' | 'h2';
}
const { exclude, heading = 'From the archive', headingLevel: Heading = 'h2' } = Astro.props;
const list: Issue[] = issues.filter((i) => i.year !== exclude);
---

{
  list.length > 0 && (
    <section class="archive" aria-labelledby="archive-title">
      <div class="section-heading">
        <>
          <div>
            <>
              <span class="eyebrow">A collection, year by year</span>
              <Heading id="archive-title">{heading}</Heading>
            </>
          </div>
          <span class="archive-count">
            {list.length} {list.length === 1 ? 'issue' : 'issues'}
          </span>
        </>
      </div>
      <div class="archive-grid">
        {list.map((issue, index) => (
          <article class="archive-card">
            <a
              class="archive-cover"
              href={issueUrl(issue)}
              aria-label={`Explore the ${issue.year} issue`}
              style={`aspect-ratio: ${issue.pageRatio}`}
            >
              <span class="archive-index">{String(index + 1).padStart(2, '0')}</span>
              <img
                src={url(issue.cover)}
                srcset={imageSrcset(issue.coverSources)}
                sizes="(max-width: 720px) calc((100vw - 3rem) / 2), (max-width: 960px) calc((100vw - 6.2rem) / 3), (max-width: 1180px) calc((100vw - 7.8rem) / 4), (min-width: 1500px) calc((100vw - 14rem) / 6), calc((100vw - 10.8rem) / 4)"
                alt={`The Tempest ${issue.year} cover`}
                style={`view-transition-name: issue-cover-${issue.year}`}
                loading="lazy"
                width={issue.coverWidth}
                height={issue.coverHeight}
              />
            </a>
            <a class="archive-title" href={issueUrl(issue)}>
              <h3>{issue.year}</h3>
              <Icon name="arrow" />
            </a>
            <p class="eyebrow muted">
              {issue.pageCount} pages <i>·</i> Annual issue
            </p>
          </article>
        ))}
      </div>
    </section>
  )
}
